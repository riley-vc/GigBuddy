      replacement_content: "import React, { useState } from \'react\';\nimport { Calendar, DollarSign, Hourglass, CheckSquare, Music, Plus, X, ToggleLeft, ShieldAlert } from \'lucide-react\';\nimport { MusicianProfile, Gig, Application, MoaContract } from \'../types\';\n\ninterface MusicianDashboardProps {\n  profile: MusicianProfile;\n  gigs: Gig[];\n  applications: Application[];\n  contracts: MoaContract[];\n  onUpdateAvailability: (day: string, status: \'available\' | \'busy\' | \'tentative\') => void;\n  onAddBand: (bandName: string) => void;\n  onRemoveBand: (bandName: string) => void;\n}\n\nexport default function MusicianDashboard({\n  profile,\n  gigs,\n  applications,\n  contracts,\n  onUpdateAvailability,\n  onAddBand,\n  onRemoveBand,\n}: MusicianDashboardProps) {\n  const [newBandName, setNewBandName] = useState(\'\');\n\n  // Calculate Musician Pipeline stats\n  // Confirmed bookings are gigs where status is filled and this user is on a signed contract\n  const myGigs = contracts.filter((c) => c.status === \'fully_signed\');\n  const upcomingCount = myGigs.length;\n\n  const myApplications = applications.filter((a) => a.musicianId === profile.id);\n  const pendingCount = myApplications.filter((a) => a.status === \'pending\').length;\n\n  // Earnings are sum of compensation for fully signed & completed contracts\n  const projectedEarnings = contracts.reduce((acc, curr) => acc + curr.compensation, 0);\n\n  const handleAddBandSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (newBandName.trim()) {\n      onAddBand(newBandName.trim());\n      setNewBandName(\'\');\n    }\n  };\n\n  const cycleAvailability = (day: string, currentStatus: \'available\' | \'busy\' | \'tentative\') => {\n    let nextStatus: \'available\' | \'busy\' | \'tentative\' = \'available\';\n    if (currentStatus === \'available\') nextStatus = \'busy\';\n    else if (currentStatus === \'busy\') nextStatus = \'tentative\';\n    onUpdateAvailability(day, nextStatus);\n  };\n\n  return (\n    <div id=\"musician-dashboard-wrapper\" className=\"space-y-6\">\n      {/* 1. Pipeline Summary Trackers */}\n      <div id=\"musician-stats-row\" className=\"grid grid-cols-1 md:grid-cols-3 gap-4\">\n        {/* Tracker 1 */}\n        <div className=\"bg-zinc-900 border border-zinc-800 p-5 rounded-xl flex items-center justify-between shadow-sm relative overflow-hidden\">\n          <div className=\"space-y-1\">\n            <span className=\"text-zinc-500 text-xs font-semibold uppercase tracking-wider block\">Upcoming Gigs</span>\n            <span className=\"text-3xl font-display font-extrabold text-zinc-50 block\">{upcomingCount}</span>\n            <span className=\"text-[10px] text-zinc-400 block\">Fully contracted contracts</span>\n          </div>\n          <div className=\"w-12 h-12 rounded-lg bg-violet-600/10 border border-violet-500/10 flex items-center justify-center text-violet-400\">\n            <Calendar className=\"w-5 h-5\" />\n          </div>\n        </div>\n\n        {/* Tracker 2 */}\n        <div className=\"bg-zinc-900 border border-zinc-800 p-5 rounded-xl flex items-center justify-between shadow-sm relative overflow-hidden\">\n          <div className=\"space-y-1\">\n            <span className=\"text-zinc-500 text-xs font-semibold uppercase tracking-wider block\">Active Applications</span>\n            <span className=\"text-3xl font-display font-extrabold text-amber-400 block\">{pendingCount}</span>\n            <span className=\"text-[10px] text-zinc-400 block\">Sourcing reviews on planners</span>\n          </div>\n          <div className=\"w-12 h-12 rounded-lg bg-amber-500/10 border border-amber-500/10 flex items-center justify-center text-amber-400\">\n            <Hourglass className=\"w-5 h-5 animate-pulse\" />\n          </div>\n        </div>\n\n        {/* Tracker 3 */}\n        <div className=\"bg-zinc-900 border border-zinc-800 p-5 rounded-xl flex items-center justify-between shadow-sm relative overflow-hidden\">\n          <div className=\"space-y-1 text-zinc-50\">\n            <span className=\"text-zinc-500 text-xs font-semibold uppercase tracking-wider block\">Projected Earnings</span>\n            <span className=\"text-3xl font-display font-extrabold block text-emerald-400\">${projectedEarnings}</span>\n            <span className=\"text-[10px] text-emerald-400/80 block bg-emerald-500/5 py-0.5 px-1.5 rounded inline-block\">Secure in escrow</span>\n          </div>\n          <div className=\"w-12 h-12 rounded-lg bg-emerald-500/10 border border-emerald-500/10 flex items-center justify-center text-emerald-400\">\n            <DollarSign className=\"w-5 h-5\" />\n          </div>\n        </div>\n      </div>\n\n      <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-6\">\n        {/* Left Side: Availability & Bands */}\n        <div className=\"lg:col-span-7 space-y-6\">\n          {/* Multi-Band Availability Tracker */}\n          <div className=\"bg-zinc-900 border border-zinc-800 rounded-xl p-5 shadow-md\">\n            <div className=\"flex items-center justify-between mb-4 pb-2 border-b border-zinc-800\">\n              <div>\n                <h3 className=\"font-display font-bold text-zinc-50 text-sm\">Multi-Band Availability Tracker</h3>\n                <p className=\"text-[11px] text-zinc-500\">Click to toggle your weekly slots so band leaders can book you</p>\n              </div>\n              <ToggleLeft className=\"w-5 h-5 text-violet-400 shrink-0\" />\n            </div>\n\n            <div className=\"grid grid-cols-2 sm:grid-cols-4 md:grid-cols-7 gap-2\">\n              {Object.entries(profile.availability).map(([day, status]) => (\n                <button\n                  id={`availability-day-${day}`}\n                  key={day}\n                  type=\"button\"\n                  onClick={() => cycleAvailability(day, status)}\n                  className=\"p-3 rounded-lg border flex flex-col items-center justify-center gap-1.5 cursor-pointer text-center group transition-all active:scale-95\"\n                >\n                  <span className=\"text-[10px] font-mono font-semibold text-zinc-400 uppercase tracking-wider\">\n                    {day.substring(0, 3)}\n                  </span>\n                  <span className={`px-2 py-0.5 rounded text-[9px] font-bold uppercase ${\n                    status === \'available\'\n                      ? \'bg-emerald-500/10 text-emerald-400 border border-emerald-500/20\'\n                      : status === \'busy\'\n                      ? \'bg-red-500/10 text-red-400 border border-red-500/20\'\n                      : \'bg-amber-500/10 text-amber-400 border border-amber-500/20\'\n                  }`}>\n                    {status}\n                  </span>\n                </button>\n              ))}\n            </div>\n\n            {/* Quick Helper Legend */}\n            <div className=\"flex justify-center gap-4 mt-4 pt-4 border-t border-zinc-800/60 text-[10px] text-zinc-500\">\n              <span className=\"flex items-center gap-1\">\n                <span className=\"w-1.5 h-1.5 rounded-full bg-emerald-400\" /> Available (Ready to Book)\n              </span>\n              <span className=\"flex items-center gap-1\">\n                <span className=\"w-1.5 h-1.5 rounded-full bg-red-400\" /> Busy (Gig/Practice locked)\n              </span>\n              <span className=\"flex items-center gap-1\">\n                <span className=\"w-1.5 h-1.5 rounded-full bg-amber-400\" /> Tentative (Pending Hold)\n              </span>\n            </div>\n          </div>\n\n          {/* Active Band Registry */}\n          <div className=\"bg-zinc-900 border border-zinc-800 rounded-xl p-5 shadow-md\">\n            <h3 className=\"font-display font-bold text-zinc-50 text-sm mb-1\">Live Band & Project Registry</h3>\n            <p className=\"text-[11px] text-zinc-500 mb-4\">Add projects you actively tour or play session work with</p>\n\n            <div className=\"space-y-3\">\n              <form onSubmit={handleAddBandSubmit} className=\"flex gap-2\">\n                <input\n                  id=\"input-add-band\"\n                  type=\"text\"\n                  placeholder=\"e.g. Chicago Jazz Collective\"\n                  value={newBandName}\n                  onChange={(e) => setNewBandName(e.target.value)}\n                  className=\"flex-1 bg-zinc-950 border border-zinc-800 text-zinc-50 rounded-lg py-2 px-3 text-xs focus:outline-none focus:border-violet-500\"\n                />\n                <button\n                  id=\"btn-add-band\"\n                  type=\"submit\"\n                  className=\"px-3 bg-violet-600 hover:bg-violet-500 text-zinc-50 text-xs rounded-lg font-bold flex items-center gap-1 transition-colors cursor-pointer\"\n                >\n                  <Plus className=\"w-3.5 h-3.5\" /> Registry\n                </button>\n              </form>\n\n              <div className=\"flex flex-wrap gap-2 pt-2\">\n                {profile.bands.map((band) => (\n                  <span \n                    key={band} \n                    className=\"px-2.5 py-1.5 bg-zinc-950 border border-zinc-850 rounded-lg text-xs text-zinc-300 flex items-center gap-1.5\"\n                  >\n                    <Music className=\"w-3 h-3 text-violet-400\" />\n                    <span>{band}</span>\n                    <button\n                      id={`remove-band-${band}`}\n                      type=\"button\"\n                      onClick={() => onRemoveBand(band)}\n                      className=\"text-zinc-500 hover:text-zinc-300 p-0.5 rounded cursor-pointer\"\n                    >\n                      <X className=\"w-3 h-3\" />\n                    </button>\n                  </span>\n                ))}\n                {profile.bands.length === 0 && (\n                  <span className=\"text-xs text-zinc-500 italic\">No band projects listed. Add one above!</span>\n                )}\n              </div>\n            </div>\n          </div>\n        </div>\n\n        {/* Right Side: Visual Profile Summary */}\n        <div className=\"lg:col-span-5 space-y-4\">\n          <div className=\"bg-zinc-900 border border-zinc-800 rounded-xl p-5 shadow-md relative overflow-hidden\">\n            <div className=\"flex gap-3.5 items-center pb-4 border-b border-zinc-800\">\n              <img \n                referrerPolicy=\"no-referrer\" \n                src={profile.avatar} \n                alt={profile.name} \n                className=\"w-11 h-11 rounded-xl object-cover border border-zinc-800\"\n              />\n              <div>\n                <h4 className=\"font-display font-extrabold text-zinc-50 text-base\">{profile.name}</h4>\n                <p className=\"text-xs text-violet-400 font-medium\">{profile.primaryInstrument}</p>\n              </div>\n            </div>\n\n            <div className=\"py-4 space-y-3.5 text-xs\">\n              <div>\n                <span className=\"text-[10px] font-mono text-zinc-500 uppercase tracking-wider block mb-1\">Artist Bio</span>\n                <p className=\"text-zinc-300 leading-relaxed italic\">\n                  \"{profile.bio}\"\n                </p>\n              </div>\n\n              <div>\n                <span className=\"text-[10px] font-mono text-zinc-500 uppercase tracking-wider block mb-1.5\">Verified Performance Skills</span>\n                <div className=\"flex flex-wrap gap-1\">\n                  {profile.skills.map((skill) => (\n                    <span key={skill} className=\"px-2 py-0.5 bg-zinc-950 border border-zinc-850 text-[10px] text-zinc-400 rounded-md font-mono\">\n                      \342\234\223 {skill}\n                    </span>\n                  ))}\n                </div>\n              </div>\n            </div>\n\n            <div className=\"bg-zinc-950 p-3.5 rounded-lg border border-zinc-850 flex gap-2.5 items-start\">\n              <CheckSquare className=\"w-4 h-4 text-emerald-400 shrink-0 mt-0.5\" />\n              <p className=\"text-[11px] text-zinc-400 leading-relaxed\">\n                <strong className=\"text-zinc-200\">Payment Security Note:</strong> Your verified skills tag matches automatic search queries. Complete all gigs as scheduled to receive prompt escrow settlement.\n              </p>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n}\n"
    }
