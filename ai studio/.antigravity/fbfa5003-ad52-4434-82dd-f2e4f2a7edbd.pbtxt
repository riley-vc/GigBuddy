ole === \'musician\'\n              ? \'bg-violet-600 text-zinc-50 shadow-md shadow-violet-600/15 font-bold\'\n              : \'text-zinc-400 hover:text-zinc-200 hover:bg-zinc-900\'\n          }`}\n        >\n          <Music className=\"w-3.5 h-3.5\" />\n          <span>Live Musician</span>\n        </button>\n      </div>\n    </div>\n  );\n}\n"
