    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { Calendar, Users, Briefcase, FileSignature, Check, X, Shield, FileText, ArrowRight } from \'lucide-react\';\nimport { Gig, Application, MoaContract } from \'../types\';\n\ninterface OrganizerDashboardProps {\n  gigs: Gig[];\n  applications: Application[];\n  contracts: MoaContract[];\n  onApproveApplication: (appId: string) => void;\n  onRejectApplication: (appId: string) => void;\n  onCancelGig: (gigId: string) => void;\n  onOpenContract: (contract: Partial<MoaContract>) => void;\n}\n\nexport default function OrganizerDashboard({\n  gigs,\n  applications,\n  contracts,\n  onApproveApplication,\n  onRejectApplication,\n  onCancelGig,\n  onOpenContract,\n}: OrganizerDashboardProps) {\n  const [activeTab, setActiveTab] = useState<\'managed\' | \'applicants\' | \'contracts\'>(\'managed\');\n\n  // Stats calculation\n  const activeOpenCalls = gigs.filter((g) => g.status === \'open\').length;\n  const pendingApps = applications.filter((a) => a.status === \'pending\').length;\n  const confirmedBookings = gigs.filter((g) => g.status === \'filled\').length;\n\n  return (\n    <div id=\"organizer-dashboard-wrapper\" className=\"space-y-6\">\n      {/* 1. High-Level Metrics Trackers */}\n      <div id=\"organizer-metrics-row\" className=\"grid grid-cols-1 md:grid-cols-3 gap-4\">\n        {/* Metric 1 */}\n        <div className=\"bg-zinc-900 border border-zinc-800 p-5 rounded-xl flex items-center justify-between shadow-sm relative overflow-hidden\">\n          <div className=\"space-y-1\">\n            <span className=\"text-zinc-500 text-xs font-semibold uppercase tracking-wider block\">Active Open Calls</span>\n            <span className=\"text-3xl font-display font-extrabold text-zinc-50 block\">{activeOpenCalls}</span>\n            <span className=\"text-[10px] text-zinc-400 block\">Sourcing live musicians</span>\n          </div>\n          <div className=\"w-12 h-12 rounded-lg bg-violet-600/10 border border-violet-500/10 flex items-center justify-center text-violet-400\">\n            <Briefcase className=\"w-5 h-5\" />\n          </div>\n        </div>\n\n        {/* Metric 2 */}\n        <div className=\"bg-zinc-900 border border-zinc-800 p-5 rounded-xl flex items-center justify-between shadow-sm relative overflow-hidden\">\n          <div className=\"space-y-1 text-zinc-50\">\n            <span className=\"text-zinc-500 text-xs font-semibold uppercase tracking-wider block\">Pending Applications</span>\n            <span className=\"text-3xl font-display font-extrabold block text-amber-400\">{pendingApps}</span>\n            <span className=\"text-[10px] text-zinc-400 block\">Requires vetting & approval</span>\n          </div>\n          <div className=\"w-12 h-12 rounded-lg bg-amber-500/10 border border-amber-500/10 flex items-center justify-center text-amber-400\">\n            <Users className=\"w-5 h-5\" />\n          </div>\n        </div>\n\n        {/* Metric 3 */}\n        <div className=\"bg-zinc-900 border border-zinc-800 p-5 rounded-xl flex items-center justify-between shadow-sm relative overflow-hidden\">\n          <div className=\"space-y-1\">\n            <span className=\"text-zinc-500 text-xs font-semibold uppercase tracking-wider block\">Confirmed Bookings</span>\n            <span className=\"text-3xl font-display font-extrabold text-emerald-400 block\">{confirmedBookings}</span>\n            <span className=\"text-[10px] text-zinc-400 block\">Escrow locked & verified</span>\n          </div>\n          <div className=\"w-12 h-12 rounded-lg bg-emerald-500/10 border border-emerald-500/10 flex items-center justify-center text-emerald-400\">\n            <Shield className=\"w-5 h-5\" />\n          </div>\n        </div>\n      </div>\n\n      {/* Navigation Sub-Tabs */}\n      <div id=\"organizer-tabs-nav\" className=\"flex border-b border-zinc-800\">\n        <button\n          id=\"btn-tab-managed\"\n          onClick={() => setActiveTab(\'managed\')}\n          className={`px-5 py-3 text-xs font-bold uppercase tracking-wider border-b-2 transition-colors cursor-pointer ${\n            activeTab === \'managed\'\n              ? \'border-violet-600 text-zinc-50\'\n              : \'border-transparent text-zinc-400 hover:text-zinc-200\'\n          }`}\n        >\n          My Events ({gigs.length})\n        </button>\n        <button\n          id=\"btn-tab-applicants\"\n          onClick={() => setActiveTab(\'applicants\')}\n          className={`px-5 py-3 text-xs font-bold uppercase tracking-wider border-b-2 transition-colors relative cursor-pointer ${\n            activeTab === \'applicants\'\n              ? \'border-violet-600 text-zinc-50\'\n              : \'border-transparent text-zinc-400 hover:text-zinc-200\'\n          }`}\n        >\n          Review Candidates ({pendingApps})\n          {pendingApps > 0 && (\n            <span className=\"absolute top-2 right-1.5 w-2 h-2 rounded-full bg-amber-500 animate-ping\" />\n          )}\n        </button>\n        <button\n          id=\"btn-tab-contracts\"\n          onClick={() => setActiveTab(\'contracts\')}\n          className={`px-5 py-3 text-xs font-bold uppercase tracking-wider border-b-2 transition-colors cursor-pointer ${\n            activeTab === \'contracts\'\n              ? \'border-violet-600 text-zinc-50\'\n              : \'border-transparent text-zinc-400 hover:text-zinc-200\'\n          }`}\n        >\n          MoA Agreements ({contracts.length})\n        </button>\n      </div>\n\n      {/* Tab Panels */}\n      <div id=\"organizer-tab-panel\" className=\"space-y-4\">\n        {/* A. My Managed Gigs */}\n        {activeTab === \'managed\' && (\n          <div className=\"space-y-4\">\n            <div className=\"flex items-center justify-between\">\n              <h3 className=\"font-display font-semibold text-zinc-100 text-sm\">Managed Events Timeline</h3>\n              <span className=\"text-[11px] font-mono text-zinc-500\">Updated seconds ago</span>\n            </div>\n\n            {gigs.length === 0 ? (\n              <div className=\"bg-zinc-900 border border-zinc-800 rounded-xl p-8 text-center space-y-3\">\n                <p className=\"text-sm text-zinc-400\">No gigs have been created yet.</p>\n                <p className=\"text-xs text-zinc-500\">Switch to the \"Publish Open Gig Call\" tab to generate your first event!</p>\n              </div>\n            ) : (\n              <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n                {gigs.map((gig) => {\n                  const gigApps = applications.filter((a) => a.gigId === gig.id);\n                  const activeAppCount = gigApps.filter((a) => a.status === \'pending\').length;\n\n                  return (\n                    <div \n                      key={gig.id} \n                      className=\"bg-zinc-900 border border-zinc-800 rounded-xl p-5 hover:border-zinc-700 transition-colors flex flex-col justify-between space-y-4\"\n                    >\n                      <div className=\"space-y-2\">\n                        <div className=\"flex justify-between items-start gap-2\">\n                          <span className={`px-2 py-0.5 rounded text-[10px] uppercase font-bold font-mono tracking-wider ${\n                            gig.status === \'open\' \n                              ? \'bg-violet-500/10 text-violet-400 border border-violet-500/20\' \n                              : gig.status === \'filled\' \n                              ? \'bg-emerald-500/10 text-emerald-400 border border-emerald-500/20\' \n                              : \'bg-zinc-850 text-zinc-500\'\n                          }`}>\n                            {gig.status === \'open\' ? \'Sourcing Artists\' : gig.status === \'filled\' ? \'Booked & Locked\' : \'Cancelled\'}\n                          </span>\n                          <span className=\"font-mono font-bold text-emerald-400 text-sm\">${gig.budget}</span>\n                        </div>\n\n                        <div>\n                          <h4 className=\"font-display font-bold text-zinc-100 text-base line-clamp-1\">{gig.title}</h4>\n                          <p className=\"text-xs text-zinc-400 flex items-center gap-1 mt-1 font-mono\">\n                            <Calendar className=\"w-3.5 h-3.5 text-zinc-500 shrink-0\" />\n                            <span>{gig.date}</span>\n                            <span className=\"text-zinc-600\">|</span>\n                            <span>{gig.venueName}</span>\n                          </p>\n                        </div>\n\n                        {/* Technical Tag summaries */}\n                        <div className=\"flex flex-wrap gap-1 pt-1\">\n                          {gig.instruments.map((i) => (\n                            <span key={i} className=\"px-1.5 py-0.5 bg-zinc-950 text-[9px] font-mono text-zinc-400 rounded\">\n                              {i}\n                            </span>\n                          ))}\n                        </div>\n                      </div>\n\n                      <div className=\"pt-4 border-t border-zinc-800/60 flex items-center justify-between text-xs\">\n                        <span className=\"text-zinc-400\">\n                          <strong>{gigApps.length}</strong> applicants ({activeAppCount} pending review)\n                        </span>\n\n                        <div className=\"flex gap-2\">\n                          {gig.status === \'open\' && (\n                            <button\n                              id={`cancel-gig-${gig.id}`}\n                              onClick={() => onCancelGig(gig.id)}\n                              className=\"px-2.5 py-1.5 bg-zinc-950 hover:bg-red-500/10 hover:text-red-400 text-zinc-500 rounded text-[11px] font-semibold transition-colors\"\n                            >\n                              Cancel Call\n                            </button>\n                          )}\n                          {activeAppCount > 0 && (\n                            <button\n                              id={`view-applicants-${gig.id}`}\n                              onClick={() => setActiveTab(\'applicants\')}\n                              className=\"px-2.5 py-1.5 bg-violet-600 hover:bg-violet-500 text-zinc-50 rounded text-[11px] font-semibold transition-all flex items-center gap-1\"\n                            >\n                              Review <ArrowRight className=\"w-3 h-3\" />\n                            </button>\n                          )}\n                        </div>\n                      </div>\n                    </div>\n                  );\n                })}\n              </div>\n            )}\n          </div>\n        )}\n\n        {/* B. Review Applicants */}\n        {activeTab === \'applicants\' && (\n          <div className=\"space-y-4\">\n            <h3 className=\"font-display font-semibold text-zinc-100 text-sm\">Musician Applications Awaiting Review</h3>\n\n            {pendingApps === 0 ? (\n              <div className=\"bg-zinc-900 border border-zinc-800 rounded-xl p-8 text-center space-y-2\">\n                <p className=\"text-sm text-zinc-400\">No pending musician applications are available for review.</p>\n                <p className=\"text-xs text-zinc-500\">Wait for sessionists to apply to your open calls in the marketplace, or publish more calls!</p>\n              </div>\n            ) : (\n              <div className=\"space-y-4\">\n                {applications\n                  .filter((app) => app.status === \'pending\')\n                  .map((app) => {\n                    const associatedGig = gigs.find((g) => g.id === app.gigId);\n                    if (!associatedGig) return null;\n\n                    return (\n                      <div \n                        key={app.id} \n                        className=\"bg-zinc-900 border border-zinc-800 rounded-xl p-5 hover:border-zinc-800/80 transition-all flex flex-col md:flex-row gap-5 justify-between\"\n                      >\n                        {/* Profile Details */}\n                        <div className=\"flex gap-4 items-start flex-1\">\n                          <img \n                            referrerPolicy=\"no-referrer\" \n                            src={app.musicianAvatar} \n                            alt={app.musicianName} \n                            className=\"w-12 h-12 rounded-xl object-cover border border-zinc-800 shrink-0\"\n                          />\n                          <div className=\"space-y-2 flex-1\">\n                            <div>\n                              <h4 className=\"font-display font-bold text-zinc-100 text-base flex items-center gap-2\">\n                                {app.musicianName}\n                                <span className=\"px-2 py-0.5 bg-zinc-950 border border-zinc-800 text-[9px] font-mono font-normal text-violet-400 rounded\">\n                                  {app.instrument}\n                                </span>\n                              </h4>\n                              <p className=\"text-[11px] font-mono text-zinc-500 mt-0.5\">\n                                Applying for: <strong className=\"text-zinc-300 font-sans font-medium\">\"{associatedGig.title}\"</strong>\n                              </p>\n                            </div>\n\n                            {/* Skills tags */}\n                            <div className=\"flex flex-wrap gap-1\">\n                              {app.skills.map((skill) => (\n                                <span key={skill} className=\"px-2 py-0.5 bg-zinc-950 text-[10px] font-mono text-zinc-400 rounded\">\n                                  {skill}\n                                </span>\n                              ))}\n                            </div>\n\n                            {/* Cover Letter */}\n                            <div className=\"bg-zinc-950/60 p-3.5 rounded-lg border border-zinc-850 text-xs text-zinc-300 leading-relaxed italic\">\n                              \"{app.coverNote}\"\n                            </div>\n                          </div>\n                        </div>\n\n                        {/* Interactive Decision Block */}\n                        <div className=\"flex md:flex-col justify-end gap-2 shrink-0 border-t md:border-t-0 border-zinc-800 pt-3 md:pt-0\">\n                          <div className=\"text-right hidden md:block mb-1.5\">\n                            <span className=\"text-[10px] text-zinc-500 block font-mono\">Offer payout</span>\n                            <span className=\"text-sm font-bold text-emerald-400 font-mono\">${associatedGig.budget}</span>\n                          </div>\n\n                          <div className=\"flex gap-2 w-full md:w-auto\">\n                            <button\n                              id={`reject-app-${app.id}`}\n                              onClick={() => onRejectApplication(app.id)}\n                              className=\"flex-1 md:flex-none px-3.5 py-2 bg-zinc-950 hover:bg-zinc-800 border border-zinc-850 text-zinc-400 rounded-lg text-xs font-semibold transition-colors flex items-center justify-center gap-1.5\"\n                            >\n                              <X className=\"w-3.5 h-3.5 text-red-400\" />\n                              Decline\n                            </button>\n                            <button\n                              id={`approve-app-${app.id}`}\n                              onClick={() => onApproveApplication(app.id)}\n                              className=\"flex-1 md:flex-none px-4 py-2 bg-violet-600 hover:bg-violet-500 text-zinc-50 rounded-lg text-xs font-semibold shadow-md shadow-violet-600/10 transition-all flex items-center justify-center gap-1.5\"\n                            >\n                              <Check className=\"w-3.5 h-3.5\" />\n                              Approve & Draft MoA\n                            </button>\n                          </div>\n                        </div>\n                      </div>\n                    );\n                  })}\n              </div>\n            )}\n          </div>\n        )}\n\n        {/* C. MoA Agreements (Archived and live contracts) */}\n        {activeTab === \'contracts\' && (\n          <div className=\"space-y-4\">\n            <h3 className=\"font-display font-semibold text-zinc-100 text-sm\">Memorandums of Agreement & Escrow States</h3>\n\n            {contracts.length === 0 ? (\n              <div className=\"bg-zinc-900 border border-zinc-800 rounded-xl p-8 text-center space-y-1\">\n                <p className=\"text-sm text-zinc-400\">No contracts exist yet.</p>\n                <p className=\"text-xs text-zinc-500\">Approve candidate applications to draft legally-binding standard performance agreements.</p>\n              </div>\n            ) : (\n              <div className=\"grid grid-cols-1 gap-3\">\n                {contracts.map((contract) => (\n                  <div \n                    key={contract.id} \n                    className=\"bg-zinc-900 border border-zinc-800 rounded-xl p-4 flex flex-col md:flex-row items-start md:items-center justify-between gap-4\"\n                  >\n                    <div className=\"flex items-center gap-3.5\">\n                      <div className=\"p-2.5 bg-violet-500/10 text-violet-400 rounded-lg shrink-0\">\n                        <FileText className=\"w-5 h-5\" />\n                      </div>\n                      <div>\n                        <h4 className=\"font-display font-bold text-zinc-100 text-sm\">{contract.gigTitle}</h4>\n                        <div className=\"flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-zinc-400 mt-1 font-mono\">\n                          <span>Venue: {contract.venueName}</span>\n                          <span className=\"text-zinc-700\">\342\200\242</span>\n                          <span>Compensation: <strong className=\"text-emerald-400\">${contract.compensation}</strong></span>\n                        </div>\n                      </div>\n                    </div>\n\n                    <div className=\"flex items-center gap-3 w-full md:w-auto justify-between md:justify-end border-t md:border-t-0 border-zinc-800/60 pt-3.5 md:pt-0\">\n                      <span className={`px-2 py-0.5 rounded text-[10px] uppercase font-bold font-mono ${\n                        contract.status === \'fully_signed\'\n                          ? \'bg-emerald-500/10 text-emerald-400 border border-emerald-500/20\'\n                          : contract.status === \'completed\'\n                          ? \'bg-zinc-800 text-zinc-400\'\n                          : \'bg-amber-500/10 text-amber-400 border border-amber-500/20\'\n                      }`}>\n                        {contract.status === \'fully_signed\' ? \'Fully Signed (Escrow Active)\' : contract.status === \'completed\' ? \'Archived (Completed)\' : \'Awaiting Signatures\'}\n                      </span>\n\n                      <button\n                        id={`open-contract-${contract.id}`}\n                        onClick={() => onOpenContract(contract)}\n                        className=\"px-3 py-1.5 bg-zinc-950 hover:bg-zinc-800 text-zinc-300 rounded border border-zinc-850 text-xs font-semibold transition-colors flex items-center gap-1.5\"\n                      >\n                        <FileSignature className=\"w-3.5 h-3.5\" />\n                        View MoA\n                      </button>\n                    </div>\n                  </div>\n                ))}\n              </div>\n            )}\n          </div>\n        )}\n      </div>\n    </div>\n  );\n}\n"
    }
